# Copy this file to .env.local for local development and fill in real
# values. Never commit .env.local — it's already in .gitignore.
#
# All three of these are the PUBLIC Storefront API credentials — safe to
# ship in client-side code by design. Never put an Admin API token here
# or anywhere else in this project.

# Your store's myshopify.com domain (not your custom domain), e.g.:
VITE_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# From Shopify Admin → Sales channels → Headless → Storefront API access token
VITE_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-public-storefront-token

# Current supported Shopify Storefront API version — see README
# "Maintenance: Shopify API version" for how/when to bump this.
VITE_SHOPIFY_API_VERSION=2026-07
